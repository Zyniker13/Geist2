{
  "$id": "https://example.com/barapp/modules/schema/recipe-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BarApp module recipe, format version 1",
  "description": "One line of data/recipes.jsonl: the recipe shape the app stores, in pour order, with required provenance. Unknown fields are allowed and ignored by readers.",
  "type": "object",
  "required": ["id", "name", "ingredients", "instructions", "provenance"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$",
      "description": "Stable within the module; references from other recipes must resolve inside it."
    },
    "name": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Alternate names that answer in search."
    },
    "glass": { "type": "string", "minLength": 1 },
    "method": {
      "enum": [
        "build",
        "stir",
        "shake",
        "throw",
        "swizzle",
        "blend",
        "layer",
        "muddle-and-build"
      ]
    },
    "ice": { "type": "string", "minLength": 1 },
    "garnish": { "type": "string", "minLength": 1 },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taxonomyId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
            "description": "A dot path into the taxonomy the manifest's minTaxonomyVersion names."
          },
          "label": { "type": "string", "minLength": 1 },
          "amount": {
            "type": "string",
            "minLength": 1,
            "description": "A decimal number or a recognized fraction; absent for \"to taste\" lines."
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "description": "A unit key from the unit catalog; absent for \"to taste\" lines."
          },
          "optional": { "type": "boolean" },
          "garnish": { "type": "boolean" }
        },
        "anyOf": [
          { "required": ["taxonomyId"] },
          { "required": ["label"] }
        ],
        "additionalProperties": false
      }
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "description": "The method, in the author's own words."
    },
    "historyNote": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "variantOf": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$",
      "description": "The parent recipe's id, which must exist in the same module."
    },
    "provenance": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
